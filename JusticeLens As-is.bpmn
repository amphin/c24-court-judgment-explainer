  <bpmn:collaboration id="Collaboration_158umhe">
    <bpmn:participant id="Participant_0lher4u" processRef="Process_0ox9pmj" />
    <bpmn:textAnnotation id="TextAnnotation_0zbewbl">
      <bpmn:text>Hard to work out a staff member's process from notes - leans of staff memory</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1dzsnkt">
      <bpmn:text>At least half a day spent on reading and understanding one judgement</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0uq7vpu">
      <bpmn:text>Lack of standardisation, despite being the most accountable process</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0i3o6k2">
      <bpmn:text>A large volume of cases published every week</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0y5d45u">
      <bpmn:text>Time constraints lead to misinterpretations of case</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0st6p9o" associationDirection="None" sourceRef="Activity_07dmyce" targetRef="TextAnnotation_0zbewbl" />
    <bpmn:association id="Association_053s3qy" associationDirection="None" sourceRef="Activity_17tzh9x" targetRef="TextAnnotation_1dzsnkt" />
    <bpmn:association id="Association_1nvdk09" associationDirection="None" sourceRef="Activity_016k438" targetRef="TextAnnotation_0uq7vpu" />
    <bpmn:association id="Association_1774hfb" associationDirection="None" sourceRef="Activity_1mb39p7" targetRef="TextAnnotation_0i3o6k2" />
    <bpmn:association id="Association_1y2elg8" associationDirection="None" sourceRef="Activity_07dmyce" targetRef="TextAnnotation_0y5d45u" />
  </bpmn:collaboration>
