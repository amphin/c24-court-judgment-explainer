    </bpmn:laneSet>
    <bpmn:task id="Activity_1mb39p7" name="1. Check Find Case Law for newly published judgements">
      <bpmn:incoming>Flow_1e9ekah</bpmn:incoming>
      <bpmn:outgoing>Flow_0f2p8jg</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_1wkd570" name="2. Skim high-level details of each judgement">
      <bpmn:incoming>Flow_0f2p8jg</bpmn:incoming>
      <bpmn:outgoing>Flow_14wfspf</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_07dmyce" name="3. Copy into spreadsheet, make rough notes on if relevant">
      <bpmn:incoming>Flow_14wfspf</bpmn:incoming>
      <bpmn:outgoing>Flow_187wmcu</bpmn:outgoing>
    </bpmn:task>
    <bpmn:startEvent id="Event_0iynpvy" name="Serious Case Desk Scan">
      <bpmn:outgoing>Flow_1e9ekah</bpmn:outgoing>
    </bpmn:startEvent>
