          "name": "Postgres account 6"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const c = $json;\nconst LIMIT = 2900;\nconst MARK  = '\\n\\n[TRUNCATED — leave unchanged]';\n\nconst clip = (v) => {\n  const s = v == null ? '' : String(v);\n  return s.length > LIMIT ? s.slice(0, LIMIT) + MARK : s;\n};\n\nconst fields = [\n  ['key_facts',          'Key facts',                                      true],\n  ['legal_issue',        'Legal issue',                                    true],\n  ['outcome',            'Outcome',                                        true],\n  ['disposal',           'Disposal (allowed|dismissed|remitted|other)',    false],\n  ['wider_relevance',    'Wider relevance',                                true],\n  ['procedural_posture', 'Procedural posture (first_instance|appeal)',     false],\n  ['key_quotes',         'Key quotes (JSON array)',                        true],\n  ['difficult_terms',    'Difficult terms (JSON array)',                   true]\n];\n\nconst blocks = [\n  { type: 'section', text: { type: 'mrkdwn',\n      text: `*Edit AI briefing*\\n${c.case_name || ''}\\n\\`${c.document_uri}\\`` } },\n  { type: 'divider' }\n];\n\nfor (const [key, label, multi] of fields) {\n  const el = { type: 'plain_text_input', action_id: 'value', multiline: multi };\n  const v = clip(c[key]);\n  if (v !== '') el.initial_value = v;          // Slack rejects an empty initial_value\n  blocks.push({\n    type: 'input',\n    block_id: key,\n    optional: true,\n    label: { type: 'plain_text', text: label },\n    element: el\n  });\n}\n\nblocks.push({\n  type: 'input',\n  block_id: 'edit_summary',\n  optional: true,\n  label: { type: 'plain_text', text: 'Edit summary' },\n  element: { type: 'plain_text_input', action_id: 'value', multiline: true }\n});\n\nblocks.push({\n  type: 'actions',\n  block_id: 'submit',\n  elements: [{\n    type: 'button',\n    action_id: 'save_brief_edits',\n    style: 'primary',\n    text: { type: 'plain_text', text: 'Save changes' },\n    value: JSON.stringify({\n      document_uri: c.document_uri,\n      actor: $('Normalise staff request').first().json.actor\n    })\n  }]\n});\n\nreturn { json: { blocksJson: JSON.stringify(blocks) } };"
      },
