    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT document_uri, case_name, key_facts, legal_issue, outcome, disposal,\n       wider_relevance, procedural_posture,\n       key_quotes::text      AS key_quotes,\n       difficult_terms::text AS difficult_terms\nFROM cases\nWHERE document_uri = $1;",
