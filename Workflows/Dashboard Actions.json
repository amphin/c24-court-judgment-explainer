    {
      "parameters": {
        "jsCode": "const REASON_CODES = {\n  'Legal accuracy — misstates the judgment': 'accuracy',\n  'Mistranslation — plain English changes the meaning': 'mistranslation',\n  'Unsupported claim — no paragraph reference': 'groundedness',\n  'Quote not verbatim or wrongly attributed': 'quote_integrity',\n  'Strays into legal advice': 'legal_advice_risk',\n  'Predicts an outcome or infers motive': 'guardrail_breach',\n  'Tone or sensitivity unsuitable': 'tone',\n  'Missing or broken source links': 'traceability',\n  'Extraction confidence too low to publish': 'low_confidence',\n  'Wrong case selected at triage': 'wrong_selection',\n  'Other — see notes': 'other'\n};\n\nconst j = $json;\nconst isForm = j.submittedAt !== undefined || j.formMode !== undefined;\n\nif (isForm) {\n  const label = String(j['Rejection reason'] || '').trim();\n  const notes = String(j['Notes'] || '').trim();\n  return [{ json: {\n    document_uri:          j.document_uri || null,\n    action:                'rejected',\n    actor:                 j.actor || 'unknown',\n    rejection_reason_code: REASON_CODES[label] || 'other',\n    rejection_reason:      notes ? `${label} — ${notes}` : label,\n    edit_summary:          null\n  }}];\n}\n\nconst q = j.query || {};\nconst b = j.body  || {};\nconst r = Object.keys(b).length ? b : q;\n\nreturn [{ json: {\n  document_uri:          r.document_uri || null,\n  action:                String(r.action || '').toLowerCase().trim(),\n  actor:                 r.actor || 'unknown',\n  rejection_reason_code: r.rejection_reason_code || null,\n  rejection_reason:      r.rejection_reason || null,\n  edit_summary:          r.edit_summary || null\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -368,
        16
      ],
